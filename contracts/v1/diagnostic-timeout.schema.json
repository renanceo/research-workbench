{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://research-workbench.example/contracts/v1/diagnostic-timeout.schema.json",
  "title": "Diagnostic Timeout v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "task_id", "status", "deadline_at", "error", "settlement"],
  "properties": {
    "contract_version": {"const": "1.0"},
    "task_id": {"type": "string", "pattern": "^diag_[A-Za-z0-9_-]{8,64}$"},
    "status": {"const": "timed_out"},
    "deadline_at": {"type": "string", "format": "date-time"},
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "public_message", "retryable"],
      "properties": {
        "code": {"const": "TASK_DEADLINE_EXCEEDED"},
        "public_message": {"type": "string", "minLength": 1, "maxLength": 500},
        "retryable": {"type": "boolean"}
      }
    },
    "settlement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "billable_minor_units", "currency"],
      "properties": {
        "action": {"enum": ["release_authorization", "refund"]},
        "billable_minor_units": {"type": "integer", "minimum": 0},
        "currency": {"type": "string", "pattern": "^[A-Z]{3}$"}
      }
    }
  }
}

